# Copy this file to .env and fill in real values. .env is gitignored.

# --- МТУСИ ЛК credentials (used to log in and scrape the schedule) ---
MTUCI_EMAIL=your.email@edu.mtuci.ru
MTUCI_PASSWORD=your-password
MTUCI_LOGIN_URL=https://lk.mtuci.ru/auth/login

# Label appended to posted messages, e.g. your group name
GROUP_LABEL=БАП2551

# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Target group/supergroup chat id (negative for supergroups)
TELEGRAM_CHAT_ID=-1001234567890
# Optional: a private chat (e.g. your own, message the bot once first) that
# receives full error tracebacks; the group only ever sees a short notice.
# Leave unset to disable.
DEBUG_CHAT_ID=

# --- Optional: where per-run state is stored (default: next to this script) ---
# TOPICS_FILE=/path/to/topics.json
# PIN_STATE_FILE=/path/to/pinned_schedule.json

# --- Optional: logging / debugging ---
# LOG_LEVEL=DEBUG
# SCRAPING_DEBUG_SCREENSHOTS=true
