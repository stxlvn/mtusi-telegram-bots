# Copy this file to .env and fill in real values. .env is gitignored.

# --- МТУСИ ЛК credentials (used to log in and scrape lk.mtuci.ru) ---
MTUCI_EMAIL=your.email@edu.mtuci.ru
MTUCI_PASSWORD=your-password
MTUCI_LOGIN_URL=https://lk.mtuci.ru/auth/login

# Label appended to posted messages (e.g. your group name); leave empty to omit
GROUP_LABEL=

# --- Telegram ---
# Token from @BotFather (shared by all three components)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Target group/supergroup chat id (negative for supergroups)
TELEGRAM_CHAT_ID=-1001234567890
# Optional: a private chat (message the bot once first) that gets full error
# tracebacks from telegram_post.py; the group only ever sees a short notice.
DEBUG_CHAT_ID=
# Private chat id of the group's admin — the only one attendance_bot.py accepts
# owner commands from (/status, /links, …). Usually same as DEBUG_CHAT_ID.
OWNER_TELEGRAM_ID=
# Words that mark presence in a lesson topic (comma-separated)
CHECKIN_KEYWORDS=+,тут,здесь

# --- LMS (lms.mtuci.ru / Moodle) conference-link scraper ---
# lms.mtuci.ru hits non-Russian IPs with a slider CAPTCHA. lms_scraper.py routes
# through a SOCKS proxy with a Russian exit — from a RU IP there is no CAPTCHA and
# it just logs in via SSO (MTUCI_EMAIL / MTUCI_PASSWORD, same as the schedule
# scraper). Point this at your own RU proxy; leave unset to disable LMS scraping.
LMS_PROXY=socks5h://127.0.0.1:1081
# User-Agent the scraper sends (any recent desktop browser UA is fine)
# LMS_UA=Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0

# --- Optional ---
# DATA_DIR=/path/to/data          # runtime state / roster / cookies (default: ./data)
# LOG_LEVEL=DEBUG
# SCRAPING_DEBUG_SCREENSHOTS=true
